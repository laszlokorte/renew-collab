<RenewCollabWeb.RenewComponents.app_header flash={@flash} blank={true} />

<h2 style="text-align: center; margin-top: 3em;">Confirm Sign up</h2>
<div style="margin: auto; width: max-content;">
  <p>Thank you for signing up.</p>
  <p>Please choose a password to complete your registration.</p>
</div>
<div style="display: grid; justify-content: center;" class="rnw-form">
  <.password_form changeset={@changeset} action={~p"/signup/#{@registration.id}/#{@code}"} />
</div>

<div style="display: grid; justify-content: center; text-align: center; margin: 2em;">
  <p>
    Do you already have an account? Go <a style="color: #23875d" href={~p"/login"}>Login</a>
  </p>
</div>

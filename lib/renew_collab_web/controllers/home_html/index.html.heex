<RenewCollabWeb.RenewComponents.app_header flash={@flash} blank={true} logout={true} />

<ul style="display: grid; justify-content: center; padding: 1em; list-style: none; gap: 1em; grid-template-columns: repeat(auto-fit, minmax(25em, 1fr));">
  <li style="background-color: #eee;">
    <.link
      style="gap: 1em; text-align: center; padding: 2em; display: block; color: #078; display: flex; flex-direction: column; align-items: center;"
      navigate={~p"/projects"}
    >
      <img class="icon" src="/assets/icon-project.svg" /> My Projects
    </.link>
  </li>
  <li style="background-color: #eee;">
    <.link
      style="gap: 1em; text-align: center; padding: 2em; display: block; color: #078; display: flex; flex-direction: column; align-items: center;"
      navigate={~p"/account/me"}
    >
      <img class="icon" src="/assets/icon-user.svg" /> My Account
    </.link>
  </li>
</ul>
<%= if is_admin(@conn) do %>
  <h2 style="border-bottom: 2px solid gray;text-align: center;padding: 1ex">Administration</h2>
  <ul style="display: grid; justify-content: center; padding: 1em; list-style: none; gap: 1em; grid-template-columns: repeat(auto-fit, minmax(25em, 1fr));">
    <li style="background-color: #eee;">
      <.link
        style="gap: 1em; text-align: center; padding: 2em; display: block; color: #078; display: flex; flex-direction: column; align-items: center;"
        navigate={~p"/manage/projects"}
      >
        <img class="icon" src="/assets/icon-project.svg" /> All Projects
      </.link>
    </li>
    <li style="background-color: #eee;">
      <.link
        style="gap: 1em; text-align: center; padding: 2em; display: block; color: #078; display: flex; flex-direction: column; align-items: center;"
        navigate={~p"/manage/documents"}
      >
        <img class="icon" src="/assets/icon-document.svg" /> All Documents
      </.link>
    </li>
    <li style="background-color: #eee;">
      <.link
        style="gap: 1em; text-align: center; padding: 2em; display: block; color: #078; display: flex; flex-direction: column; align-items: center;"
        navigate={~p"/manage/simulations"}
      >
        <img class="icon" src="/assets/icon-simulation.svg" /> All Simulations
      </.link>
    </li>
    <li style="background-color: #eee;">
      <.link
        style="gap: 1em; text-align: center; padding: 2em; display: block; color: #078; display: flex; flex-direction: column; align-items: center;"
        navigate={~p"/accounts"}
      >
        <img class="icon" src="/assets/icon-user.svg" /> Accounts
      </.link>
    </li>
    <li style="background-color: #eee;">
      <.link
        style="gap: 1em; text-align: center; padding: 2em; display: block; color: #078; display: flex; flex-direction: column; align-items: center;"
        navigate={~p"/health"}
      >
        <img class="icon" src="/assets/icon-health.svg" /> Health
      </.link>
    </li>
    <li style="background-color: #eee;">
      <.link
        style="gap: 1em; text-align: center; padding: 2em; display: block; color: #078; display: flex; flex-direction: column; align-items: center;"
        navigate={~p"/system"}
      >
        <img class="icon" src="/assets/icon-system.svg" /> System
      </.link>
    </li>
  </ul>
  <h3 style="gap: 1em; text-align: center;">
    Template Configuration
  </h3>
  <ul style="display: grid; justify-content: center; padding: 1em; list-style: none; gap: 1em; grid-template-columns: repeat(auto-fit, minmax(25em, 1fr));">
    <li style="background-color: #eee;">
      <.link
        style="gap: 1em; text-align: center; padding: 2em; display: block; color: #078; display: flex; flex-direction: column; align-items: center;"
        navigate={~p"/socket_schemas"}
      >
        <img class="icon" src="/assets/icon-socket.svg" /> Socket Schemas
      </.link>
    </li>

    <li style="background-color: #eee;">
      <.link
        style="gap: 1em; text-align: center; padding: 2em; display: block; color: #078; display: flex; flex-direction: column; align-items: center;"
        navigate={~p"/icons"}
      >
        <img class="icon" src="/assets/icon-symbol.svg" /> Icons
      </.link>
    </li>

    <li style="background-color: #eee;">
      <.link
        style="gap: 1em; text-align: center; padding: 2em; display: block; color: #078; display: flex; flex-direction: column; align-items: center;"
        navigate={~p"/syntax"}
      >
        <img class="icon" src="/assets/icon-syntax.svg" /> Syntax
      </.link>
    </li>

    <li style="background-color: #eee;">
      <.link
        style="gap: 1em; text-align: center; padding: 2em; display: block; color: #078; display: flex; flex-direction: column; align-items: center;"
        navigate={~p"/primitives"}
      >
        <img class="icon" src="/assets/icon-lego.svg" /> Primitives
      </.link>
    </li>
  </ul>
<% end %>
